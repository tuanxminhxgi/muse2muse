# Copy sang .env và điền giá trị thật. KHÔNG commit .env lên git.
# Không gửi token này cho ai qua chat — chỉ dán vào file .env trên máy của bạn.

# Bắt buộc nếu muốn dùng Telegram (xem README bước 1-2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tùy chọn
PORT=8797
HOST=127.0.0.1
# BRIDGE_TOKEN: để trống thì server tự tạo 1 lần và lưu vào token.txt
# BRIDGE_TOKEN=
# BRIDGE_TOKEN_EXPIRES_AT: ngày hết hạn của token, dạng ISO 8601, ví dụ 2027-01-01T00:00:00Z.
# Để trống = token không bao giờ hết hạn. Khi đã quá hạn, trang mailbox và API
# trả lỗi "token expired — delete token.txt and restart to rotate": xóa token.txt
# (và gỡ BRIDGE_TOKEN trong .env nếu có) rồi restart server để tạo token mới.
# BRIDGE_TOKEN_EXPIRES_AT=
# DATA_FILE=messages.jsonl
# TELEGRAM_POLL_MS=2000
# OUTBOX: khi gửi sang Telegram thất bại, tin được lưu vào outbox.jsonl và server
# tự thử lại mỗi 30 giây, tối đa 5 lần rồi bỏ (xem README "Reliable sync").

# GitHub webhook → thread (v1.3.0): tạo secret ở GitHub repo → Settings →
# Webhooks → Add webhook: Payload URL https://<tunnel-host>/api/github-webhook,
# Content type application/json, Secret = giá trị dưới đây, chọn event push,
# pull requests, issues, issue comments, releases. Không đặt = webhook tắt.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_REPOS=tuanxminhxgi/muse2muse,tuanxminhxgi/agent-tools

# Digest + nhắc việc (v1.3.0): mỗi sáng lúc DIGEST_TIME (giờ địa phương của máy
# chạy bridge) server tự đăng digest các task đang mở + nhắc task quá hạn.
# DIGEST_ENABLED=true
# DIGEST_TIME=08:00
# DIGEST_REMINDER_HOURS=24
# WATCHDOG_FILE=watchdog.json

# Auto-deploy khi PR merge (v1.4.0): dùng chung GITHUB_WEBHOOK_SECRET ở trên
# (webhook v1.3.0). Chỉ deploy khi push / PR-merge vào DEPLOY_BRANCH của repo
# muse2muse. AUTO_DEPLOY_ENABLED=0 tắt hẳn. REPO_DIR là thư mục git trên PC
# (mặc định là thư mục chứa server.js).
# AUTO_DEPLOY_ENABLED=true
# DEPLOY_BRANCH=main
# REPO_DIR=
# DEPLOY_RESTART_DELAY_MS=1500

# Lệnh Telegram quản lý task (v1.4.0): /tasks, /done, /assign, /status,
# /help + nút inline dưới tin task. Chỉ nhận từ TELEGRAM_CHAT_ID.
# TELEGRAM_COMMANDS_ENABLED=true

# Digest thông báo định kỳ + ack bắt buộc cho task (v1.14.0): tin routine
# (presence offline + GitHub webhook) gom vào digest mỗi giờ thay vì gửi
# Telegram ngay; tin routine lưu trữ ngay trên board. Offline vượt ngưỡng
# thì báo ngay. Task giao cho Muse nào phải ack trong 10 phút, quá hạn
# bridge nhắc 1 lần rồi leo thang báo Martin.
# NOTICE_DIGEST_ENABLED=true
# NOTICE_DIGEST_MINUTES=60
# PRESENCE_OFFLINE_ESCALATE_MINUTES=30
# TASK_ACK_ENABLED=true
# TASK_ACK_TIMEOUT_MINUTES=10

# Báo cáo tuần (v1.15.0, ý 3 ở #351): mỗi tuần 1 lần vào WEEKLY_REPORT_DAY
# lúc WEEKLY_REPORT_TIME (giờ địa phương của máy chạy bridge), tóm tắt 7
# ngày qua: task đã xong, PR đã merge, task/idea mới tạo, task còn mở theo
# người nhận, quá hạn/cần chú ý. WEEKLY_REPORT_DAY: 0=Chủ nhật … 6=Thứ 7
# (mặc định 1=Thứ 2). Tắt hẳn lịch: WEEKLY_REPORT_ENABLED=0 (ép đăng tay
# qua POST /api/weekly-report vẫn được). Digest sáng (v1.3.0, mở rộng ở
# v1.15.0) cũng thêm mục "Đã xong 24h qua" (task xong + PR đã merge).
# WEEKLY_REPORT_ENABLED=true
# WEEKLY_REPORT_DAY=1
# WEEKLY_REPORT_TIME=08:00

# Menu nút bấm /start + xác nhận bằng reaction ✅ (v1.13.0): /start mở
# bàn phím inline (Task, PR, Trạng thái, Digest); bấm ✅ vào tin gốc trên
# Telegram để xác nhận đã đọc (ghi lên read_by + confirmed_by của tin).
# TELEGRAM_REACTION_CONFIRM_ENABLED=0 tắt hẳn việc nhận reaction.
# TELEGRAM_REACTION_CONFIRM_ENABLED=true

# Task lifecycle (v1.9.0): claim → doing → review → done; khóa task hết
# hạn sau TASK_LOCK_TIMEOUT_MINUTES phút không hoạt động (=0: khóa không
# bao giờ hết hạn). Nhắc task quá hạn / hạn hôm nay mỗi ngày 1 lần;
# TASK_REMINDER_ENABLED=0 tắt hẳn việc nhắc.
# TASK_LOCK_TIMEOUT_MINUTES=60
# TASK_REMINDER_ENABLED=true

# Duyệt nhanh PR trên Telegram (v1.9.0): nút ✅ Duyệt / 🔀 Merge dưới tin
# PR + lệnh /approve, /merge. Duyệt chỉ ghi quyết định lên thread, không
# cần token. Merge thật cần GITHUB_TOKEN là PAT của Martin (repo scope,
# tạo ở GitHub → Settings → Developer settings → Personal access tokens);
# chưa đặt thì nút Merge chỉ ghi quyết định + trả link để merge tay.
# GITHUB_TOKEN=

# Review chéo PR tự động (v1.10.0): webhook PR opened/synchronize thì
# Muse khác tác giả đăng review kiểm tra tự động lên thread (số file đổi,
# +/− dòng, draft, conflict). AUTO_REVIEW_ENABLED=false tắt hẳn. Có
# GITHUB_TOKEN ở trên thì review lấy thêm danh sách file đổi và đăng
# comment lên PR; không có token thì chỉ review trên thread.
# AUTO_REVIEW_ENABLED=true
# Đồng bộ 2 chiều board ↔ GitHub Issues (v1.11.0): nút "Tạo Issue" trên
# mỗi task (hoặc POST /api/messages/:id/sync-issue) tạo Issue trên repo
# GITHUB_ISSUES_REPO, gắn label GITHUB_ISSUES_LABEL; task sang done thì
# Issue tự đóng, mở lại task thì Issue tự mở lại; webhook issues /
# issue_comment phản chiếu lên thread và đổi trạng thái task liên kết
# theo (Issue đóng → task done, mở lại → task todo). Dùng chung
# GITHUB_TOKEN ở trên (PAT, repo scope). Chưa đặt token thì yêu cầu
# tạo/đóng/mở Issue được đưa vào hàng chờ (issue-sync.json, task hiện
# cờ "chờ đồng bộ") và thử lại bằng POST /api/issues/retry sau khi đặt
# token + restart bridge. GITHUB_ISSUES_SYNC_ENABLED=0 tắt hẳn tính
# năng. Webhook GitHub cần chọn thêm event "issue comments" (cùng với
# issues đã có) ở GitHub repo → Settings → Webhooks.
# GITHUB_ISSUES_SYNC_ENABLED=true
# GITHUB_ISSUES_REPO=tuanxminhxgi/muse2muse
# GITHUB_ISSUES_LABEL=board-task

# Presence + catch-up digest (v1.4.0): báo Martin qua Telegram khi 1 Muse
# quá PRESENCE_OFFLINE_MINUTES phút không check-in (1 lần / lần offline;
# =0 tắt hẳn). Muse quay lại sau PRESENCE_DIGEST_MINUTES phút thì
# POST /api/heartbeat trả kèm digest các tin chưa đọc.
# PRESENCE_OFFLINE_MINUTES=10
# PRESENCE_DIGEST_MINUTES=10
