# Copy sang .env và điền giá trị thật. KHÔNG commit .env lên git.
# Không gửi token này cho ai qua chat — chỉ dán vào file .env trên máy của bạn.

# Bắt buộc nếu muốn dùng Telegram (xem README bước 1-2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Tùy chọn
PORT=8797
HOST=127.0.0.1
# BRIDGE_TOKEN: để trống thì server tự tạo 1 lần và lưu vào token.txt
# BRIDGE_TOKEN=
# BRIDGE_TOKEN_EXPIRES_AT: ngày hết hạn của token, dạng ISO 8601, ví dụ 2027-01-01T00:00:00Z.
# Để trống = token không bao giờ hết hạn. Khi đã quá hạn, trang mailbox và API
# trả lỗi "token expired — delete token.txt and restart to rotate": xóa token.txt
# (và gỡ BRIDGE_TOKEN trong .env nếu có) rồi restart server để tạo token mới.
# BRIDGE_TOKEN_EXPIRES_AT=
# DATA_FILE=messages.jsonl
# TELEGRAM_POLL_MS=2000
# OUTBOX: khi gửi sang Telegram thất bại, tin được lưu vào outbox.jsonl và server
# tự thử lại mỗi 30 giây, tối đa 5 lần rồi bỏ (xem README "Reliable sync").

# GitHub webhook → thread (v1.3.0): tạo secret ở GitHub repo → Settings →
# Webhooks → Add webhook: Payload URL https://<tunnel-host>/api/github-webhook,
# Content type application/json, Secret = giá trị dưới đây, chọn event push,
# pull requests, issues, releases. Không đặt = webhook tắt.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_REPOS=tuanxminhxgi/muse2muse,tuanxminhxgi/agent-tools

# Digest + nhắc việc (v1.3.0): mỗi sáng lúc DIGEST_TIME (giờ địa phương của máy
# chạy bridge) server tự đăng digest các task đang mở + nhắc task quá hạn.
# DIGEST_ENABLED=true
# DIGEST_TIME=08:00
# DIGEST_REMINDER_HOURS=24
# WATCHDOG_FILE=watchdog.json
