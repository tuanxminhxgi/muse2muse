[Unit]
Description=Cloudflared tunnel for Muse Bridge
After=network-online.target muse-bridge.service
Wants=network-online.target muse-bridge.service

[Service]
Type=simple
User=martin
ExecStart=/usr/bin/cloudflared tunnel --config /home/martin/.cloudflared/config.yml run muse-bridge-ubuntu
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
